    "name": "未対応者を見つけて督促",
    "description": "対象の一覧と対応済みの記録を突き合わせ、未対応の人だけに通知する。提出・入力の督促の骨格。",
    "createdAt": "2026-09-08T00:00:00.000Z",
    "updatedAt": "2026-09-08T00:00:00.000Z"
  },
  "viewport": { "x": 30, "y": 20, "zoom": 0.62 },
  "nodes": [
    {
      "id": "note-decisions",
      "type": "note",
      "position": { "x": 340, "y": 40 },
      "data": {
        "title": "決めておくこと",
        "config": {},
        "notes": "・誰を対象にするか（絞り込みの条件）\n・「対応済み」を何で判断するか\n・いつから促すか（期限の何日前か）\n・同じ人へ何度まで送るか、二重送信をどう防ぐか\n・突合できなかったデータをどう扱うか\n・失敗したときリトライするか、実行ログをどこに残すか"
      }
    },
    {
      "id": "trigger-schedule",
      "type": "trigger",
      "position": { "x": 40, "y": 40 },
      "data": {
        "title": "定期実行",
        "description": "毎日など決まったタイミングで起動する",
        "config": {
          "system": "スケジューラ",
          "event": "決まった間隔での起動"
        }
      }
    },
    {
      "id": "ds-targets",
      "type": "dataSource",
      "position": { "x": 40, "y": 160 },
      "data": {
        "title": "対象の一覧を取得",
        "description": "誰に対応してもらう必要があるかを読む",
        "config": { "provider": "台帳 / 名簿" }
      }
    },
    {
      "id": "ds-records",
      "type": "dataSource",
      "position": { "x": 40, "y": 280 },
      "data": {
        "title": "対応済みの記録を取得",
        "description": "すでに対応が済んでいる証跡を読む",
        "config": { "provider": "提出物 / 入力済みデータ" }
      }
    },
    {
      "id": "act-match",
      "type": "action",
      "position": { "x": 40, "y": 400 },
      "data": {
        "title": "突合して未対応を抽出",
        "description": "一覧と記録を突き合わせ、残っている人を出す",
        "config": { "operation": "対象と記録を突合し、未対応だけを残す" }
      }
    },
    {
      "id": "cond-any",
      "type": "condition",
      "position": { "x": 40, "y": 520 },
      "data": {
        "title": "未対応があるか？",
        "config": { "branches": ["ある", "ない"] }
      }
    },
    {
      "id": "end-none",
      "type": "end",
      "position": { "x": 340, "y": 700 },
      "data": {
        "title": "対象なし",
        "config": { "outcome": "Completed（対象なし）" }
      }
    },
    {
      "id": "notif-remind",
      "type": "notification",
      "position": { "x": 40, "y": 700 },
      "data": {
        "title": "担当者へ督促する",
