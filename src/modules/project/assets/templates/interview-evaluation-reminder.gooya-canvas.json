    "name": "Interview Evaluation Reminder",
    "description": "面接終了後に評価入力を促し、未入力であれば Teams で再通知する業務フロー。GOOYA Canvas の Reference Workflow。",
    "createdAt": "2026-09-08T00:00:00.000Z",
    "updatedAt": "2026-09-08T00:00:00.000Z"
  },
  "viewport": { "x": 30, "y": 20, "zoom": 0.52 },
  "nodes": [
    {
      "id": "0c1f7b2e-9a34-4d58-8e61-1b2c3d4e5f60",
      "type": "note",
      "position": { "x": 340, "y": 40 },
      "data": {
        "title": "このサンプルについて",
        "description": "初回起動時に読み込まれる Reference Workflow です",
        "config": {},
        "notes": "File > New で空のプロジェクトを作成できます。ノードをクリックすると設定を確認できます。"
      }
    },
    {
      "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
      "type": "trigger",
      "position": { "x": 40, "y": 40 },
      "data": {
        "title": "面接終了（Google Calendar）",
        "description": "面接イベントの終了を検知する",
        "config": {
          "system": "Google Calendar",
          "event": "Interview event ended"
        }
      }
    },
    {
      "id": "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d6e",
      "type": "wait",
      "position": { "x": 40, "y": 160 },
      "data": {
        "title": "60 分待機",
        "description": "面接直後の評価入力を待つ",
        "config": { "duration": 60, "unit": "minutes" }
      }
    },
    {
      "id": "3c4d5e6f-7a8b-4c9d-8e0f-2a3b4c5d6e7f",
      "type": "condition",
      "position": { "x": 40, "y": 280 },
      "data": {
        "title": "評価は入力済みか？",
        "description": "評価シートの入力有無を判定する",
        "config": { "branches": ["Yes", "No"] }
      }
    },
    {
      "id": "4d5e6f7a-8b9c-4d0e-9f1a-3b4c5d6e7f80",
      "type": "end",
      "position": { "x": 340, "y": 460 },
      "data": {
        "title": "完了（評価入力済み）",
        "config": { "outcome": "Completed" }
      }
    },
    {
      "id": "5e6f7a8b-9c0d-4e1f-8a2b-4c5d6e7f8091",
      "type": "notification",
      "position": { "x": 40, "y": 460 },
      "data": {
        "title": "Teams で評価入力を依頼",
        "description": "面接担当者へ 1 回目の督促を送る",
        "config": {
          "provider": "Microsoft Teams",
          "recipient": "面接担当者",
          "message": "本日の面接の評価入力をお願いします。",
          "purpose": "評価入力の督促（1 回目）"
        }
      }
    },
    {
      "id": "6f7a8b9c-0d1e-4f2a-9b3c-5d6e7f8091a2",
      "type": "wait",
      "position": { "x": 40, "y": 580 },
      "data": {
        "title": "24 時間待機",
        "description": "督促後の入力を待つ",
        "config": { "duration": 24, "unit": "hours" }
      }
    },
    {
      "id": "7a8b9c0d-1e2f-4a3b-8c4d-6e7f8091a2b3",
      "type": "condition",
      "position": { "x": 40, "y": 700 },
      "data": {
        "title": "評価は入力済みか？（再確認）",
        "description": "24 時間後にもう一度判定する",
        "config": { "branches": ["Yes", "No"] }
      }
    },
    {
      "id": "8b9c0d1e-2f3a-4b4c-9d5e-7f8091a2b3c4",
      "type": "end",
      "position": { "x": 340, "y": 880 },
      "data": {
        "title": "完了（督促後に入力）",
        "config": { "outcome": "Completed" }
      }
    },
    {
      "id": "9c0d1e2f-3a4b-4c5d-8e6f-8091a2b3c4d5",
      "type": "notification",
      "position": { "x": 40, "y": 880 },
      "data": {
        "title": "Teams で再通知",
        "description": "面接担当者と採用マネージャーへエスカレーションする",
        "config": {
          "provider": "Microsoft Teams",
          "recipient": "面接担当者 / 採用マネージャー",
          "message": "評価が未入力です。本日中の入力をお願いします。",
          "purpose": "評価入力の督促（2 回目 / エスカレーション）"
        }
      }
    },
    {
      "id": "a0d1e2f3-4b5c-4d6e-9f70-91a2b3c4d5e6",
      "type": "end",
      "position": { "x": 40, "y": 1000 },
      "data": {
        "title": "完了（再通知まで実施）",
        "config": { "outcome": "Completed" }
      }
    }
  ],
