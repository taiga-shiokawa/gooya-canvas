    "name": "チャットから自然文で検索",
    "description": "チャットの問い合わせから条件を読み取り、データを検索して結果を返す。台帳の照会を会話でできるようにする骨格。",
    "createdAt": "2026-09-08T00:00:00.000Z",
    "updatedAt": "2026-09-08T00:00:00.000Z"
  },
  "viewport": { "x": 30, "y": 20, "zoom": 0.7 },
  "nodes": [
    {
      "id": "note-decisions",
      "type": "note",
      "position": { "x": 340, "y": 40 },
      "data": {
        "title": "決めておくこと",
        "config": {},
        "notes": "・検索できる条件は何か（項目を先に決める）\n・何件まで返すか、超えたぶんをどう伝えるか\n・見せてよい項目と見せない項目\n・AI に任せる範囲（条件の読み取りまでか、絞り込みもか）\n・答えられないときに何を返すか\n・失敗時のリトライ、問い合わせログを残すか"
      }
    },
    {
      "id": "trigger-chat",
      "type": "trigger",
      "position": { "x": 40, "y": 40 },
      "data": {
        "title": "チャットでの問い合わせ",
        "description": "利用者が自然文で質問する",
        "config": {
          "system": "チャットツール",
          "event": "利用者の発話"
        }
      }
    },
    {
      "id": "ai-parse",
      "type": "ai",
      "position": { "x": 40, "y": 160 },
      "data": {
        "title": "問い合わせから条件を読み取る",
        "config": {
          "task": "自然文を検索条件に変換する",
          "input": "利用者の質問",
          "expectedOutput": "決めておいた項目の値",
          "constraints": "書かれていないことは推測しない"
        }
      }
    },
    {
      "id": "ds-search",
      "type": "dataSource",
      "position": { "x": 40, "y": 280 },
      "data": {
        "title": "条件でデータを検索",
        "description": "読み取った条件でデータを絞り込む",
        "config": { "provider": "台帳 / データベース" }
      }
    },
    {
      "id": "cond-any",
      "type": "condition",
      "position": { "x": 40, "y": 400 },
      "data": {
        "title": "該当があるか？",
        "config": { "branches": ["ある", "ない"] }
      }
    },
    {
      "id": "notif-result",
      "type": "notification",
      "position": { "x": 40, "y": 580 },
      "data": {
        "title": "結果を返す",
        "config": {
          "provider": "チャットツール",
          "recipient": "質問した人",
          "message": "検索結果と件数",
          "purpose": "照会への回答"
        }
      }
    },
    {
      "id": "notif-none",
      "type": "notification",
      "position": { "x": 340, "y": 580 },
      "data": {
        "title": "該当なしを返す",
        "config": {
          "provider": "チャットツール",
          "recipient": "質問した人",
          "message": "条件に合うデータはありませんでした",
          "purpose": "0 件であることの明示"
        }
      }
    },
    {
      "id": "end-answered",
      "type": "end",
      "position": { "x": 190, "y": 700 },
      "data": {
        "title": "回答完了",
        "config": { "outcome": "Completed" }
      }
    }
  ],
