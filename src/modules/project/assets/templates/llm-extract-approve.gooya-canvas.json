      "type": "end",
      "position": { "x": 340, "y": 700 },
      "data": {
        "title": "反映しない",
        "config": { "outcome": "Rejected" }
      }
    },
    {
      "id": "act-apply",
      "type": "action",
      "position": { "x": 40, "y": 700 },
      "data": {
        "title": "システムへ反映する",
        "description": "承認された内容だけを書き込む",
        "config": { "operation": "承認された項目を更新する" }
      }
    },
